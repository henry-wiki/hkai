# ============================================
# HKAI 環境設定範本（只列名稱，永不填值）
# 用法：複製本檔為 .env，再填入你自己的值
# 注意：.env 永不入版控
# ============================================

# —— 模型供應商金鑰（用哪個供應商就填哪一項）——
OPENROUTER_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OPENCODE_API_KEY=
KILO_API_KEY=
MIMO_API_KEY=
MIMO_TOKEN_PLAN_API_KEY=

# —— 應用密鑰（可留空；上線前建議填一段隨機值）——
APP_SECRET=

# —— 時區（可留空；預設 Asia/Hong_Kong。安裝精靈會用瀏覽器時區自動填入）——
APP_TIMEZONE=

# —— 機器路徑（執行檔位置；請填你自己的路徑）——
python_executable=

# 選用：goose 引擎執行檔
goose_executable=

# 選用：自帶 aider 套件目錄（留空 = 使用系統已安裝的 aider）
aider_pylibs_dir=

# 選用：benchmark 資料源（跑排行榜抓取先需要）
BENCHMARK_SRC_LLM_STATS_API_KEY=
BENCHMARK_SRC_AA_API_KEY=