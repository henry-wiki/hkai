{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HKAI",
  "version": "0.1.0",
  "identifier": "hkai.local.shell",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HKAI",
        "width": 360,
        "height": 240,
        "center": true,
        "resizable": true,
        "visible": false,
        "url": "index.html",
        "decorations": true,
        "backgroundColor": "#15171b"
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": false
  }
}
