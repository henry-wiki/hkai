# ============================================
# HKAI 環境設定（出廠／本機共用——內容只准相對路徑）
# 注意：API key 唔放呢度——由設定頁寫入 <data_dir>/config/api_keys.json
# ============================================


# —— 機器路徑（執行檔位置）——
python_executable   =/execute/python313/python.exe
goose_executable    =/execute/goose/goose.exe
node_dir            =/execute/node
playwright_dir      =/execute/playwright-1.64.1

# —— 應用識別（決定資料根路徑：<base>/<vendor>/<app>/data）——
APP_VENDOR  = seacorner
APP_NAME    = hkai

# —— 資料根（DB／訊息／log）——
DATA_DIR    = data
